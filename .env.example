MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=rai_planner
JWT_SECRET=change-me-to-long-random-string-min-32-chars
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ENCRYPTION_KEY=optional-separate-encryption-key
# Security hardening (recommended in production — see SECURITY.md)
# Sandbox: project paths must resolve inside this directory when set
#PROJECTS_ROOT=/path/to/your/projects
# Disable public registration after your account exists (true/false)
#ALLOW_SIGNUP=false
# Leave /api (relative) when frontend is served behind a reverse proxy or the vite dev server.
# Set to e.g. http://localhost:8000/api only if the browser talks to the backend directly.
VITE_API_URL=/api
