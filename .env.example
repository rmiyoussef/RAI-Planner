MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=rai_planner
POSTGRES_URI=postgresql://rami@127.0.0.1:5433/rai_planner
POSTGRES_DATABASE=rai_planner
JWT_SECRET=change-me-to-long-random-string-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
API_PREFIX=/api
# Ports — change freely. start.sh, update.sh and the vite dev server follow
# these (uvicorn/vite bind to them). The backend app itself ignores them.
# If FRONTEND_PORT changes, also update its origin in CORS_ORIGINS below.
BACKEND_PORT=8000
FRONTEND_PORT=5173
PROJECT_NAME=RAI Planner
MAX_FILE_SIZE_BYTES=1048576
MAX_CONTEXT_BYTES=200000
ENCRYPTION_KEY=optional-separate-encryption-key
# Security hardening (recommended in production — see SECURITY.md)
# Sandbox: project paths must resolve inside this directory when set
#PROJECTS_ROOT=/path/to/your/projects
# Disable public registration after your account exists (true/false)
#ALLOW_SIGNUP=false
# Leave /api (relative) when frontend is served behind a reverse proxy or the vite dev server.
# Set to e.g. http://localhost:8000/api only if the browser talks to the backend directly.
VITE_API_URL=/api
VITE_APP_NAME=RAI Planner
